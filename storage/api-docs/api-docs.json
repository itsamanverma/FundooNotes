        "/api/makelabel": {
            "post": {
                "tags": [
                    "Labels"
                ],
                "summary": "Create a new label",
                "operationId": "d83b7715a65ac2f423987f912c94de47",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "label"
                                ],
                                "properties": {
                                    "label": {
                                        "type": "string",
                                        "example": "Work"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Label created"
                    },
                    "210": {
                        "description": "Duplicate label"
                    },
                    "401": {
                        "description": "Unauthorized"
                    }
                },
                "security": [
                    {
                        "passport": []
