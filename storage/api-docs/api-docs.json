        "/api/addnotelabel": {
            "post": {
                "tags": [
                    "Labels"
                ],
                "summary": "Add a label to a note",
                "operationId": "addef3e64b76e1470cf32beca0cd2122",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "labelid",
                                    "noteid"
                                ],
                                "properties": {
                                    "labelid": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "noteid": {
                                        "type": "integer",
                                        "example": 2
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Label added to note"
                    },
                    "210": {
                        "description": "Note already has label"
                    },
                    "401": {
                        "description": "Unauthorized"
                    }
                },
                "security": [
                    {
                        "passport": []
                    }
                ]
            }
