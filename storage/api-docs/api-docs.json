                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "labelid",
                                    "label"
                                ],
                                "properties": {
                                    "labelid": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "label": {
                                        "type": "string",
                                        "example": "Personal"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
